# Copy this file to .env and fill in real values. Never commit .env.
# Schema/validation source of truth: artifacts/api-server/src/config.ts

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (lib/db, Supabase/Postgres connection string) ────────────────
DATABASE_URL=

# ── Auth (custom JWT via jose) ──────────────────────────────────────────────
# Min 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Login session duration. The default supports a normal working day without
# creating a long-lived administrator credential.
JWT_EXPIRES_IN=8h
# Comma-separated emails that get role='admin' on first registration.
ADMIN_BOOTSTRAP_EMAILS=

# ── LLM provider (AI-assisted resource import) ──────────────────────────────
# "gemini" | "anthropic" (anthropic not implemented yet)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ── Transactional email (registration / password reset) ────────────────────
# "brevo" | "microsoft_graph". Microsoft Graph works with personal Outlook,
# Hotmail, or Live mailboxes and sends over HTTPS rather than SMTP.
EMAIL_PROVIDER=brevo

# Required only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Required only when EMAIL_PROVIDER=microsoft_graph. Keep OAuth credentials and
# refresh tokens out of source control.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
MICROSOFT_FROM_EMAIL=

# ── Frontend ──────────────────────────────────────────────────────────────
# Used to build links in outgoing emails (e.g. password reset).
FRONTEND_URL=http://localhost:5173

# ── CORS ────────────────────────────────────────────────────────────────────
# Development additionally allows only localhost:5173/127.0.0.1:5173. Set one
# or more comma-separated deployed frontend origins in production.
CORS_ORIGIN=

# ── Logging ─────────────────────────────────────────────────────────────────
# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ── Scholar APIs (upload pipeline link/metadata resolution) ─────────────────
# Polite-pool contact email for Crossref/OpenAlex, required by Unpaywall. Use a
# project mailbox (it appears in outgoing requests), not a personal one.
SCHOLAR_CONTACT_EMAIL=
# Optional — raises Semantic Scholar's rate limit. Leave empty for the free tier.
SEMANTIC_SCHOLAR_API_KEY=
